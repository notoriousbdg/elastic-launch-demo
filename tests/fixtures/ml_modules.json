      "over": null,
      "partition": "cloud.region"
     }
    ],
    "influencers": [
     "InstanceId",
     "cloud.region",
     "cloud.account.id"
    ]
   }
  ],
  "fields": [
   "Namespace",
   "InstanceId",
   "metrics.amazonaws.com/AWS/EC2/CPUUtilization",
   "cloud.region",
   "metrics.amazonaws.com/AWS/EC2/CPUCreditBalance",
   "metrics.amazonaws.com/AWS/EC2/NetworkOut",
   "cloud.account.id",
   "stat",
   "MetricName"
  ]
