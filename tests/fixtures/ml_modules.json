   "aws_ec2_otel"
  ],
  "package": "aws_ec2_otel",
  "version": "0.14.0",
  "id": "aws_ec2_otel-metrics-ml",
  "default_index": "metrics-aws.ec2.otel-*",
  "index_mismatch": false,
  "discovery_datasets": [
   "aws.ec2.otel"
  ],
  "query": {
   "bool": {
    "filter": [
     {
      "term": {
       "Namespace": "AWS/EC2"
      }
     },
     {
      "exists": {
       "field": "InstanceId"
      }
     }
    ],
    "must_not": {
     "terms": {
      "_tier": [
       "data_frozen",
       "data_cold"
      ]
     }
    }
   }
  },
  "datafeeds": [
   {
    "id": "datafeed-aws_ec2_instance_resource_anomaly",
    "job_id": "aws_ec2_instance_resource_anomaly",
    "query": {
     "bool": {
      "filter": [
       {
        "term": {
         "stat": "Average"
        }
       },
       {
        "terms": {
         "MetricName": [
          "CPUUtilization",
          "CPUCreditBalance",
          "NetworkOut"
         ]
        }
       },
       {
        "exists": {
         "field": "InstanceId"
        }
       }
      ]
     }
    },
    "fields": [
     "stat",
     "MetricName",
     "InstanceId",
     "cloud.account.id",
     "cloud.region"
    ],
    "aggregated": true
   }
  ],
  "jobs": [
   {
    "id": "aws_ec2_instance_resource_anomaly",
    "bucket_span": "15m",
    "summary_count_field_name": "doc_count",
    "detectors": [
     {
      "function": "high_mean",
      "field": "metrics.amazonaws.com/AWS/EC2/CPUUtilization",
      "by": "InstanceId",
      "over": null,
      "partition": "cloud.region"
     },
     {
      "function": "low_mean",
